# Зависимости (на случай, если подключишь Composer)
/vendor/
composer.phar

# Редакторы и IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Системные файлы
.DS_Store
Thumbs.db

# Логи и временные файлы
*.log
*.tmp
*.bak
/tmp/
/cache/

# Локальные настройки и секреты
.env
.env.*
!.env.example

# Файлы сессий PHP, если сохраняются в проект
/sessions/
sess_*

# Рабочее хранилище заказов: файлы создаются при работе приложения,
# в Git остаётся только .gitkeep
/storage/*
!/storage/.gitkeep
